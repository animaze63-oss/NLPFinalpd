{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "films.schema.json",
  "title": "Film index (site/data/films.json)",
  "type": "object",
  "required": [
    "schema_version",
    "films",
    "build"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "build": {
      "type": "object",
      "required": [
        "nltk",
        "spacy",
        "model",
        "python",
        "n_films",
        "n_reviews"
      ]
    },
    "films": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "slug",
          "title",
          "year",
          "directors",
          "n_reviews",
          "tomatometer",
          "mean_compound",
          "aspects"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string"
          },
          "year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "directors": {
            "type": "array"
          },
          "n_reviews": {
            "type": "integer"
          },
          "tomatometer": {
            "type": [
              "integer",
              "null"
            ]
          },
          "mean_compound": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "aspects": {
            "type": "object",
            "required": [
              "visuals",
              "story",
              "characters",
              "soundtrack"
            ],
            "additionalProperties": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}